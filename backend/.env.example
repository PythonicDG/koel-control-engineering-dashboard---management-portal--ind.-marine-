# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra browser origins allowed to call the API directly (the Vite dev proxy does not need this)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- PostgreSQL ----
DB_NAME=koel_marine
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ---- Server ports (used by start.py) ----
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- First-run seed data ----
# Loads the sample users/projects/ECNs when the database is empty.
SEED_SAMPLE_DATA=True

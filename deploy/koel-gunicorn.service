# /etc/systemd/system/koel-gunicorn.service
[Unit]
Description=KOEL Marine portal - Gunicorn (Django API)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
# creates /run/koel owned by www-data (holds the unix socket)
RuntimeDirectory=koel
WorkingDirectory=/home/koel-control-engineering-dashboard---management-portal--ind.-marine-/backend
ExecStart=/home/koel-control-engineering-dashboard---management-portal--ind.-marine-/backend/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/koel/gunicorn.sock \
    --umask 007 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
